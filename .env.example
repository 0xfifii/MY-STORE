# ---------------------------------------------------------------------------
# MY STORE — environment variables
# Copy to .env.local (local) or set them in your hosting provider's dashboard.
# Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string → URI).
# On serverless hosts (Vercel) use Supabase's "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://postgres:password@localhost:5432/mystore

# Set to "false" to disable SSL for the database connection (only for local/private networks).
# Remote databases use SSL automatically.
# DATABASE_SSL=false

# Max database connections per server instance (keep low on serverless, e.g. 3).
DATABASE_POOL_MAX=10

# Docker Compose only: password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-this-password

# Public URL of the app (no trailing slash).
APP_URL=http://localhost:3000

# Secret used by the scheduler to trigger the automatic daily report.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# --- Optional: email delivery of the automatic daily report ---------------
# Leave SMTP_HOST empty to keep reports in Report History only.
# Works with any SMTP provider (Gmail app password, Zoho, Brevo, Mailgun, SendGrid SMTP, Amazon SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MY STORE <reports@yourdomain.com>"
# SMTP_SECURE=true   # force TLS (defaults to true only on port 465)
